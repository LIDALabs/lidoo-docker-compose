# Copy to .env and set real values:
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Postgres (also used by Odoo to connect to the DB) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-db-password

# --- Odoo master password (/web/database manager) ---
ODOO_ADMIN_PASSWD=change-me-master-password

# --- Odoo published host ports (local / no Traefik) ---
ODOO_HTTP_PORT=10018
ODOO_GEVENT_PORT=20018

# --- pgAdmin (localhost only: http://127.0.0.1:${PGADMIN_PORT}) ---
# In the UI, add a server: host=db, port=5432, user/password = POSTGRES_*
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050

# =============================================================================
# Traefik (OPTIONAL)
# =============================================================================
# Local / servers without a reverse proxy — leave Traefik unused:
#   docker compose up -d --build
#   → Odoo on http://localhost:${ODOO_HTTP_PORT}
#
# With Traefik (TLS + public hostname):
#   1) Fill the variables below
#   2) docker compose -f docker-compose.yaml -f docker-compose.traefik.yaml up -d --build
#
# pgAdmin is never exposed via Traefik.

# Public hostname for Odoo (required when using the Traefik overlay)
ODOO_HOSTNAME=odoo.example.com

# Let's Encrypt account email (required when using the Traefik overlay)
LETS_ENCRYPT_CONTACT_EMAIL=you@example.com

# Traefik dashboard host (HTTPS + basic auth)
TRAEFIK_HOSTNAME=traefik.example.com

# Basic auth for the Traefik dashboard (htpasswd "user:hashedpassword").
#   htpasswd -nbB admin 'your-dashboard-password'
# If Compose eats $, escape each $ as $$ in .env.
TRAEFIK_BASIC_AUTH=admin:$$apr1$$replace$$with-your-own-hash

# Optional Traefik knobs
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_NETWORK_NAME=traefik-public
# true = use a pre-created external network; false = compose creates it
TRAEFIK_NETWORK_EXTERNAL=false
