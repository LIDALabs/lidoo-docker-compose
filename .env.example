# ============================================================
# Lidoo / Odoo
# ============================================================

COMPOSE_FILE=compose.yaml
# Behind Traefik:
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me


# ------------------------------------------------------------
# Odoo
# ------------------------------------------------------------

# Odoo database-manager master password.
ODOO_ADMIN_PASSWD=change-me

# Required with traefik. Must match the DNS hostname routed to this server.
ODOO_HOSTNAME=odoo.example.com

# Standalone host ports.
ODOO_HTTP_PORT=10018
ODOO_GEVENT_PORT=20018

# Address used when publishing Odoo ports.
#
# Standalone / LAN access:
ODOO_BIND_ADDRESS=0.0.0.0
#
# Recommended when behind Traefik:
# ODOO_BIND_ADDRESS=127.0.0.1


# Do not normally set ODOO_PROXY_MODE here.
# ODOO_PROXY_MODE=False


# Override only when intentionally tuning production workers:
# ODOO_WORKERS=4


# ------------------------------------------------------------
# pgAdmin
# ------------------------------------------------------------

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Bound to 127.0.0.1 by docker-compose.yaml.
PGADMIN_PORT=5050
