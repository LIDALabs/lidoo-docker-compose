# Copy to .env and set real values:
#   cp .env.example .env
# .env is gitignored — never commit real secrets.

# --- Postgres (also used by Odoo to connect to the DB) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-db-password

# --- Odoo master password (/web/database manager) ---
# Protects create/drop/backup/restore of databases. Not a user login password.
ODOO_ADMIN_PASSWD=change-me-master-password

# --- Traefik / public hostname (optional until Traefik overlay is used) ---
ODOO_HOSTNAME=odoo.example.com
LETS_ENCRYPT_CONTACT_EMAIL=you@example.com
# TRAEFIK_HOSTNAME=traefik-ui.local
# TRAEFIK_HTTP_USER=admin
# TRAEFIK_HTTP_PASSWORD=
