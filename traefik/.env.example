# ============================================================
# Lidoo / Traefik
# ============================================================

TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# DNS hostname for the Traefik dashboard.
TRAEFIK_HOSTNAME=traefik.example.com

# Basic Auth value generated with htpasswd.
#
# Example:
#   htpasswd -nb admin 'your-password'
#
# Keep this value single-quoted because htpasswd hashes contain '$'.
TRAEFIK_BASIC_AUTH='admin:$apr1$REPLACE_WITH_REAL_HASH'

LETS_ENCRYPT_CONTACT_EMAIL=admin@example.com

# Common values: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
