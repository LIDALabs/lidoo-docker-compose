#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: %s -s SOURCE -d DESTINATION\n' "${0##*/}" >&2
}

SOURCE=
DESTINATION=
while getopts ':s:d:' option; do
  case "$option" in
    s) SOURCE=$OPTARG ;;
    d) DESTINATION=$OPTARG ;;
    *) usage; exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if [[ -z "$SOURCE" || -z "$DESTINATION" || $# -ne 0 ]]; then
  usage
  exit 2
fi

docker compose stop odoo
trap 'docker compose up -d odoo' EXIT
docker compose run --rm odoo click-odoo-copydb "$SOURCE" "$DESTINATION"
